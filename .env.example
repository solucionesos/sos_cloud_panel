# ==============================================================================
# SOS Cloud Control Panel - Configuración de Entorno
# Copiar a .env o ejecutar ./deploy.sh para generación automática
# ==============================================================================

# --- Autenticación del Panel ---
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=cambia_esta_clave_segura
# Secretos aleatorios (ej: openssl rand -hex 32)
PANEL_SESSION_SECRET=
SOS_SSO_SECRET=

# --- Conexión a PostgreSQL ---
# Nombre del contenedor PostgreSQL en la red Docker (o host.docker.internal)
PG_HOST=host.docker.internal
PG_PORT=5432
PG_USER=odoo
PG_PASSWORD=odoo

# --- Descubrimiento y Dominios ---
DEFAULT_BASE_DOMAIN=solucionesos.com
NGINX_SITES_PATH=/host_nginx/sites-enabled

# --- Protección de Recursos Críticos ---
# Contenedores separados por coma que no pueden detenerse/eliminarse desde el panel
PROTECTED_CONTAINERS=sos_cloud_panel,postgres16_central

# --- Despliegue Docker Compose (opcional, tienen valores por defecto) ---
PANEL_CONTAINER_NAME=sos_cloud_panel
PANEL_BIND_IP=127.0.0.1
PANEL_PORT=8095
DOCKER_NETWORK=odoo-net
HOST_NGINX_SITES=/etc/nginx/sites-enabled
